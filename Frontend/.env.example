# ===========================================
# TradeGuardAI Frontend - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# ===========================================
# API CONFIGURATION
# ===========================================
# Local development: Point to your local backend
VITE_API_URL=http://localhost:5000

# Production (AWS): Set to RUNTIME_ORIGIN for same-origin requests
# The build process sets this automatically during deployment
# VITE_API_URL=RUNTIME_ORIGIN

# ===========================================
# EXTERNAL APIs (Optional)
# ===========================================
# Logo.dev API key for crypto logos (optional, has fallback)
VITE_LOGO_DEV_API_KEY=
