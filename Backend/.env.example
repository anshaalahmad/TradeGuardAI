# ===========================================
# TradeGuardAI Backend - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# For local development, most defaults will work

# ===========================================
# SERVER CONFIGURATION
# ===========================================
PORT=5000
NODE_ENV=development

# Frontend URL for CORS - use your local frontend port
# Local: http://localhost:5173
# Production: https://your-domain.com
FRONTEND_URL=http://localhost:5173

# ===========================================
# DATABASE (MongoDB Atlas)
# ===========================================
# Get your connection string from MongoDB Atlas
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>
DATABASE_URL="mongodb+srv://username:password@cluster.mongodb.net/tradeguardai?retryWrites=true&w=majority"

# ===========================================
# AUTHENTICATION
# ===========================================
# Generate secure random strings (min 32 characters)
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters
JWT_REFRESH_SECRET=your-refresh-token-secret-minimum-32-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth 2.0
# Get credentials from: https://console.cloud.google.com/apis/credentials
# IMPORTANT: Add BOTH callback URLs in Google Console:
#   - http://localhost:5173/auth/google/callback (local development)
#   - https://your-domain.com/auth/google/callback (production)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Admin emails (comma-separated list of admin user emails)
ADMIN_EMAILS=admin@example.com

# ===========================================
# PAYMENTS (Stripe)
# ===========================================
# Use TEST keys for local development (sk_test_..., pk_test_...)
# Use LIVE keys for production (sk_live_..., pk_live_...)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Stripe Price IDs (create in Stripe Dashboard)
STRIPE_PRO_MONTHLY_PRICE_ID=price_pro_monthly
STRIPE_PRO_YEARLY_PRICE_ID=price_pro_yearly
STRIPE_API_MONTHLY_PRICE_ID=price_api_monthly
STRIPE_API_YEARLY_PRICE_ID=price_api_yearly

# ===========================================
# EMAIL (Resend)
# ===========================================
RESEND_API_KEY=re_your-resend-api-key
FROM_EMAIL=TradeGuardAI <noreply@yourdomain.com>

# ===========================================
# EXTERNAL APIs (Optional)
# ===========================================
# CoinGecko - for enhanced rate limits
COINGECKO_API_KEY=

# Logo.dev - for crypto logos
LOGO_DEV_API_KEY=

# ===========================================
# CACHING (seconds)
# ===========================================
CACHE_TTL_CRYPTO_LIST=120
CACHE_TTL_MARKET_SUMMARY=30
CACHE_TTL_CRYPTO_DETAILS=60
